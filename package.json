{
  "name": "order-manager",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Guilherme Rauen",
  "description": "Sample of an Order Management System using Domain-Driven Design (DDD) and TypeScript.",
  "keywords": [
    "Domain-Driven-Design (DDD)",
    "Express",
    "MongoDB",
    "TypeScript"
  ],
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.json",
    "build:prod": "npm run lint && npm run test:cov && npm audit --omit dev && npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "jest --no-cache --runInBand --detectOpenHandles --verbose",
    "test:all": "npm run lint && npm run test:cov && npm audit && npm run build",
    "test:cov": "npm run test -- --collectCoverage --coverageDirectory=\"./coverage\"",
    "test:watch": "npm run test -- --watch",
    "start": "node dist/src/index.js",
    "start:dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/src/index.js\""
  },
  "dependencies": {
    "dotenv": "17.2.0",
    "express": "5.1.0",
    "express-validator": "7.2.1",
    "helmet": "8.1.0",
    "mongoose": "8.16.3",
    "pino": "9.7.0",
    "pino-pretty": "13.0.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "ts-error": "1.0.6"
  },
  "devDependencies": {
    "@eslint/compat": "1.3.1",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.13",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.36.0",
    "@typescript-eslint/parser": "8.36.0",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.0.1",
    "eslint-plugin-prettier": "5.5.1",
    "eslint-plugin-promise": "7.2.1",
    "jest": "30.0.4",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "supertest": "7.1.3",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "tsc-watch": "7.1.1",
    "typescript": "5.8.3"
  }
}
